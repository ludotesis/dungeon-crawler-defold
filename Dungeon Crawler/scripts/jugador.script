-- Importamos el módulo del mapa para comprobar si podemos caminar
local map = require("modulos.mapa")

-- Constantes
local TILE_SIZE = 1 -- Debe ser igual al tamaño que usaste en tu generador 3D
local MOVE_SPEED = 0.3 -- Segundos que tarda en avanzar una casilla
local TURN_SPEED = 0.2 -- Segundos que tarda en girar 90 grados

-- Definimos las direcciones cardinales. 
-- En 3D, el eje Z negativo suele ser "Adelante" (Norte).
local DIR_NORTH = 0
local DIR_EAST  = 1
local DIR_SOUTH = 2
local DIR_WEST  = 3

local function get_forward_vector(facing)
	-- Devuelve el modificador de (x, z) dependiendo de a dónde miramos
	if facing == DIR_NORTH then return 0, -1
	elseif facing == DIR_EAST then return 1, 0
	elseif facing == DIR_SOUTH then return 0, 1
	elseif facing == DIR_WEST then return -1, 0
	end
	return 0, 0
end

local function try_move(self, direction)
	-- Obtener hacia dónde nos moveríamos en la matriz
	local dx, dz = get_forward_vector(self.facing)

	-- Si caminamos hacia atrás, invertimos el vector
	local next_x = self.grid_x + (dx * direction)
	local next_z = self.grid_z + (dz * direction)

	-- Comprobar la matriz lógica
	if map.is_walkable(next_x, next_z) then
		self.is_moving = true
		self.grid_x = next_x
		self.grid_z = next_z

		-- Calcular la posición 3D real a la que debemos ir
		local target_pos = vmath.vector3(self.grid_x * TILE_SIZE, 0, self.grid_z * TILE_SIZE)

		-- Interpolar la posición
		go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, target_pos, go.EASING_INOUTQUAD, MOVE_SPEED, 0, function()
			self.is_moving = false -- Liberar el bloqueo de movimiento al terminar
		end)
	else
		-- Opcional: Aquí podrías reproducir un sonido de "choque" o hacer un pequeño temblor
		print("¡Hay una pared!")
	end
end

local function turn(self, turn_direction)
	self.is_moving = true

	-- Actualizar la dirección lógica (0 a 3). Usamos módulo 4 para que dé la vuelta.
	self.facing = (self.facing + turn_direction) % 4

	-- Calcular la rotación en el eje Y.
	-- Multiplicamos por -90 porque girar a la derecha (+1) en Defold es una rotación negativa en Y.
	local current_rot = go.get(".", "euler.y")
	local target_rot = current_rot + (turn_direction * -90)

	-- Interpolar la rotación
	go.animate(".", "euler.y", go.PLAYBACK_ONCE_FORWARD, target_rot, go.EASING_INOUTQUAD, TURN_SPEED, 0, function()
		self.is_moving = false
	end)
end

function init(self)
	-- Escuchar el teclado y activar la cámara
	msg.post(".", "acquire_input_focus")
	msg.post("#camera", "acquire_camera_focus")

	-- Estado inicial del jugador
	self.is_moving = false
	self.facing = DIR_NORTH

	-- Coordenadas iniciales en la matriz (asegúrate de que este punto sea un 0 en tu mapa)
	self.grid_x = 2
	self.grid_z = 2

	-- Forzamos la posición inicial 3D para que coincida con la lógica
	local start_pos = vmath.vector3(self.grid_x * TILE_SIZE, 0, self.grid_z * TILE_SIZE)
	go.set_position(start_pos)
end

function on_input(self, action_id, action)
	-- Bloquear el input si el jugador ya se está moviendo o girando,
	-- o si la tecla no acaba de ser presionada.
	if self.is_moving or not action.pressed then 
		return 
	end

	-- Mapeo de controles
	if action_id == hash("up") then
		try_move(self, 1)    -- 1 = Adelante
	elseif action_id == hash("down") then
		try_move(self, -1)   -- -1 = Atrás
	elseif action_id == hash("left") then
		turn(self, -1)       -- -1 = Girar izquierda
	elseif action_id == hash("right") then
		turn(self, 1)        -- 1 = Girar derecha
	end
end
